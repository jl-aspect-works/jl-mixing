#!/usr/bin/env bash
set -eu

status=0
for command_name in bash python3 jq; do
    if command -v "$command_name" >/dev/null 2>&1; then
        echo "[OK] $command_name"
    else
        echo "[MISSING] $command_name"
        status=1
    fi
done
for command_name in ffprobe shellcheck; do
    if command -v "$command_name" >/dev/null 2>&1; then
        echo "[OK] optional: $command_name"
    else
        echo "[OPTIONAL] not installed: $command_name"
    fi
done
exit "$status"
