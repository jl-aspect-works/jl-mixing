#!/usr/bin/env bash
# Create the authoritative JL Mixing Automation v1.1 final-delivery package.
set -eu

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APP_ROOT="${JL_MIXING_HOME:-$(cd "$SCRIPT_DIR/.." && pwd)}"
. "$APP_ROOT/lib/common.sh"
. "$APP_ROOT/lib/context.sh"
. "$APP_ROOT/lib/filesystem.sh"
. "$APP_ROOT/lib/json.sh"
. "$APP_ROOT/lib/metadata.sh"
. "$APP_ROOT/lib/platform.sh"
. "$APP_ROOT/lib/project-state.sh"
. "$APP_ROOT/lib/transaction.sh"

usage() {
    cat <<'USAGE'
Usage: create-delivery [options]

Options:
  --project PATH          Explicit project directory
  --include PATTERN       Include matching revision files; may be repeated
  --exclude PATTERN       Exclude matching revision files; may be repeated
  --working-prefix TEXT   Exclude files beginning with this prefix (default: WORK )
  --overwrite             Replace a prior package with the same delivered paths
  --clean                 Destructively replace all contents of 05_Final_Delivery
  --zip                   Create <project-id>-rev-<NN>-<local timestamp>.zip
  --dry-run               Show the planned package without creating it
  -h, --help              Show this help
USAGE
}

removed_option() {
    case "$1" in
        --revision) jl_error "--revision was removed in JL Mixing 1.1. create-delivery always uses state.approved_revision." ;;
        --checksum) jl_error "--checksum was removed in JL Mixing 1.1. SHA-256 verification is mandatory." ;;
        --mark-delivered) jl_error "--mark-delivered was removed in JL Mixing 1.1. Successful package creation records the delivered revision automatically." ;;
        --non-interactive) jl_error "--non-interactive was removed in JL Mixing 1.1. create-delivery does not prompt." ;;
    esac
    return "$JL_EXIT_ARGUMENTS"
}

project_ref=""
working_prefix="WORK "
overwrite=0
clean=0
make_zip=0
dry_run=0
include_args=()
exclude_args=()

while [ "$#" -gt 0 ]; do
    case "$1" in
        --project) [ "$#" -ge 2 ] || jl_die "--project requires a value." "$JL_EXIT_ARGUMENTS"; project_ref="$2"; shift 2 ;;
        --include) [ "$#" -ge 2 ] || jl_die "--include requires a value." "$JL_EXIT_ARGUMENTS"; [ -n "$(jl_trim "$2")" ] || jl_die "--include cannot be empty." "$JL_EXIT_ARGUMENTS"; include_args+=(--include "$2"); shift 2 ;;
        --exclude) [ "$#" -ge 2 ] || jl_die "--exclude requires a value." "$JL_EXIT_ARGUMENTS"; [ -n "$(jl_trim "$2")" ] || jl_die "--exclude cannot be empty." "$JL_EXIT_ARGUMENTS"; exclude_args+=(--exclude "$2"); shift 2 ;;
        --working-prefix) [ "$#" -ge 2 ] || jl_die "--working-prefix requires a value." "$JL_EXIT_ARGUMENTS"; working_prefix="$2"; [ -n "$working_prefix" ] || jl_die "--working-prefix cannot be empty." "$JL_EXIT_ARGUMENTS"; shift 2 ;;
        --overwrite) overwrite=1; shift ;;
        --clean) clean=1; shift ;;
        --zip) make_zip=1; shift ;;
        --dry-run) dry_run=1; shift ;;
        --revision|--checksum|--mark-delivered|--non-interactive) removed_option "$1"; exit $? ;;
        -h|--help) usage; exit 0 ;;
        *) jl_die "Unknown option: $1" "$JL_EXIT_ARGUMENTS" ;;
    esac
done

[ "$overwrite" -eq 0 ] || [ "$clean" -eq 0 ] || jl_die "--overwrite and --clean are mutually exclusive." "$JL_EXIT_ARGUMENTS"

project_root="$(jl_context_resolve_project_v11 "$project_ref" "$PWD")" || exit $?
if [ "$clean" -eq 1 ]; then
    jl_context_validate_project_v11_for_clean_delivery "$project_root" || exit $?
else
    jl_context_validate_project_v11 "$project_root" || exit $?
fi
manifest="$project_root/00_Admin/project-manifest.json"
delivery_root="$(jl_context_delivery_root_v11 "$project_root")" || exit $?
approved_revision="$(jl_json_get_json "$manifest" '.state.approved_revision')" || exit $?
[ "$approved_revision" != null ] || { jl_error "A revision must be approved before delivery can be created."; exit "$JL_EXIT_VALIDATION"; }
case "$approved_revision" in ''|*[!0-9]*|0) jl_error "Approved revision number is invalid."; exit "$JL_EXIT_VALIDATION" ;; esac
revision_root="$project_root/04_Revisions/$(printf 'Revision_%02d' "$approved_revision")"
jl_fs_is_directory_no_symlink "$revision_root" || { jl_error "Approved revision directory is missing or unsafe: $revision_root"; exit "$JL_EXIT_VALIDATION"; }
project_id="$(jl_json_get "$manifest" '.project_id')"
# Keep schema-governed manifest metadata in UTC while naming the human-facing
# archive with the workstation's local wall-clock time.
timestamp="$(jl_now_iso8601)"
zip_timestamp="$(date '+%Y%m%d%H%M%S')"
zip_name="${project_id}-rev-$(printf '%02d' "$approved_revision")-${zip_timestamp}.zip"
mode=default
[ "$overwrite" -eq 0 ] || mode=overwrite
[ "$clean" -eq 0 ] || mode=clean

work_dir="$(jl_mktemp_dir jl-mixing-create-delivery)" || exit $?
plan_file="$work_dir/plan.json"
stage_root=""
staged_manifest=""
cleanup() {
    status=$?
    [ -z "$stage_root" ] || { [ ! -e "$stage_root" ] && [ ! -L "$stage_root" ]; } || jl_fs_remove_entry_no_follow "$stage_root" || true
    [ -z "$staged_manifest" ] || rm -f -- "$staged_manifest"
    rm -rf -- "$work_dir"
    return "$status"
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM

plan_cmd=("$(jl_json_validator_python)" "$APP_ROOT/tools/build-delivery.py" plan
    --revision-dir "$revision_root" --delivery-dir "$delivery_root"
    --project-manifest "$manifest" --mode "$mode"
    --working-prefix "$working_prefix" --project-zip-name "$zip_name"
    --output "$plan_file")
[ "$make_zip" -eq 0 ] || plan_cmd+=(--zip-name "$zip_name")
# macOS ships Bash 3.2, which treats a declared-but-empty array as unbound
# when it is expanded while nounset (`set -u`) is active. Temporarily disable
# nounset only for these optional arrays so a delivery with no include/exclude
# filters remains valid without weakening error checking elsewhere.
set +u
plan_cmd+=("${include_args[@]}")
plan_cmd+=("${exclude_args[@]}")
set -u
"${plan_cmd[@]}" || exit "$JL_EXIT_VALIDATION"

print_plan() {
    printf 'Project:             %s\n' "$(jl_json_get "$manifest" '.project_name')"
    printf 'Current revision:    %s\n' "$(jl_json_get "$manifest" '.state.current_revision')"
    printf 'Approved revision:   %s\n' "$approved_revision"
    printf 'Delivered revision:  %s\n' "$(jl_json_get_json "$manifest" '.state.delivered_revision')"
    printf 'Delivery method:     %s\n' "$(jl_json_get "$manifest" '.delivery.method')"
    printf 'Replacement mode:    %s\n' "$mode"
    if [ "$make_zip" -eq 1 ]; then printf 'Create ZIP:          yes\n'; else printf 'Create ZIP:          no\n'; fi
    printf '\nSelected files:\n'
    jq -r '.selected[] | "  " + .name + "\n    Type: " + .deliverable_type + "\n    Destination: " + .path' "$plan_file"
    if [ "$(jq -r '.excluded | length' "$plan_file")" -gt 0 ]; then
        printf '\nExcluded:\n'
        jq -r '.excluded[] | "  " + .name + "    " + .reason' "$plan_file"
    fi
}

if [ "$dry_run" -eq 1 ]; then
    printf 'Dry run — no changes made.\n\n'
    print_plan
    if [ "$clean" -eq 1 ]; then
        printf '\nWarning: --clean will remove every existing item inside:\n  %s\n' "$delivery_root"
        if [ "$(jq -r '.deletions | length' "$plan_file")" -gt 0 ]; then
            printf '\nWould delete from 05_Final_Delivery/:\n'
            jq -r '.deletions[] | "  " + .' "$plan_file"
        fi
    fi
    printf '\nWould create:\n'
    jq -r '.selected[] | "  " + .path' "$plan_file"
    printf '  Delivery_Notes.md\n  delivery-manifest.json\n'
    [ "$make_zip" -eq 0 ] || printf '  %s\n' "$zip_name"
    printf '\nWould update:\n  state.delivered_revision: %s → %s\n  metadata.last_modified_at\n' "$(jl_json_get_json "$manifest" '.state.delivered_revision')" "$approved_revision"
    printf '\nSHA-256 verification will occur during actual package creation.\n'
    exit 0
fi

stage_root="$(jl_txn_stage_directory_near "$delivery_root")" || exit $?
document_id="$(jl_uuid)" || exit $?
studio_root="$(jl_context_studio_root_v11 "$project_root")" || exit $?
jl_json_assert_uuid_available "$studio_root" "$document_id" || exit $?
# Capture validated application provenance separately from the v1.1 schema.
created_with="$(jl_created_with)" || exit $?
"$(jl_json_validator_python)" "$APP_ROOT/tools/build-delivery.py" build \
    --plan "$plan_file" --project-manifest "$manifest" --delivery-dir "$delivery_root" \
    --stage-dir "$stage_root" --delivery-notes-template "$APP_ROOT/templates/Delivery_Notes.md" \
    --document-id "$document_id" --created-with "$created_with" --created-at "$timestamp" \
    --project-zip-name "$zip_name" || exit "$JL_EXIT_VALIDATION"

delivery_schema="$(jl_json_schema_path delivery-manifest.schema.json)" || exit $?
project_schema="$(jl_json_schema_path project-manifest.schema.json)" || exit $?
jl_json_validate_schema "$delivery_schema" "$stage_root/delivery-manifest.json" >/dev/null || exit $?
if [ "$make_zip" -eq 1 ]; then
    jl_require_command zip "Install zip to use create-delivery --zip." || exit $?
    # Historical generated archives remain beside the current package but are
    # never nested inside a later archive.
    (cd "$stage_root" && zip -qr "$zip_name" . \
        -x "$zip_name" "${project_id}-rev-??-??????????????.zip") || {
        jl_error "Unable to create delivery ZIP."
        exit "$JL_EXIT_GENERAL"
    }
fi
staged_manifest="$(jl_mktemp_file_near "$manifest")" || exit $?
jq --argjson revision "$approved_revision" --arg timestamp "$timestamp" \
    '.state.delivered_revision=$revision | .metadata.last_modified_at=$timestamp' \
    "$manifest" > "$staged_manifest" || exit "$JL_EXIT_GENERAL"
jl_json_validate_schema "$project_schema" "$staged_manifest" >/dev/null || exit $?

jl_txn_commit_directory_and_file "$stage_root" "$delivery_root" "$staged_manifest" "$manifest" \
    jl_context_validate_project_v11 "$project_root" || exit $?
stage_root=""; staged_manifest=""

printf 'Final delivery created successfully.\n\n'
print_plan
printf 'Files delivered:     %s\n' "$(jq -r '.selected | length' "$plan_file")"
[ "$make_zip" -eq 0 ] || printf 'ZIP:                 %s\n' "$zip_name"
printf 'Project state:       %s\n' "$(jl_project_state_derive "$project_root")"
printf '\nDelivery folder:\n  %s\n\nDelivered files:\n' "$delivery_root"
jq -r '.selected[] | "  " + .path' "$plan_file"
printf '\nNext:\n'
if [ "$make_zip" -eq 1 ]; then
    printf '  Transfer %s using the configured delivery method.\n' "$zip_name"
else
    printf '  Transfer the contents of 05_Final_Delivery using the configured delivery method.\n'
fi
