#!/usr/bin/env bash
# Human-facing project creation launcher backed by the shared project-create service.
set -eu

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APP_ROOT="${JL_MIXING_HOME:-$(cd "$SCRIPT_DIR/.." && pwd)}"
# shellcheck source=lib/project-create.sh
. "$APP_ROOT/lib/project-create.sh"

jl_project_create_command "$@"
