#!/usr/bin/env bash
# Canonical machine-facing dispatcher launcher for the JL Mixing Automation API.
set -eu

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APP_ROOT="${JL_MIXING_HOME:-$(cd "$SCRIPT_DIR/.." && pwd)}"

if [ "${1:-}" = "project" ]; then
    # shellcheck source=lib/project-create-api.sh
    . "$APP_ROOT/lib/project-create-api.sh"
    shift
    [ "$#" -gt 0 ] && [ "$1" = create ] || {
        jl_error "Unknown project operation."
        exit "$JL_EXIT_ARGUMENTS"
    }
    shift
    jl_project_create_response "$@"
elif [ "${1:-}" = "revision" ]; then
    shift
    [ "$#" -gt 0 ] || { echo "Error: Unknown revision operation." >&2; exit 2; }
    case "$1" in
        create)
            # shellcheck source=lib/revision-create-api.sh
            . "$APP_ROOT/lib/revision-create-api.sh"
            shift
            jl_revision_create_response "$@"
            ;;
        approve)
            # shellcheck source=lib/revision-approve-api.sh
            . "$APP_ROOT/lib/revision-approve-api.sh"
            shift
            jl_revision_approve_response "$@"
            ;;
        *)
            echo "Error: Unknown revision operation." >&2
            exit 2
            ;;
    esac
elif [ "${1:-}" = "intake" ]; then
    # shellcheck source=lib/intake-validate-api.sh
    . "$APP_ROOT/lib/intake-validate-api.sh"
    shift
    [ "$#" -gt 0 ] && [ "$1" = validate ] || {
        jl_error "Unknown intake operation."
        exit "$JL_EXIT_ARGUMENTS"
    }
    shift
    jl_intake_validate_response "$@"
elif [ "${1:-}" = "delivery" ]; then
    # shellcheck source=lib/delivery-create-api.sh
    . "$APP_ROOT/lib/delivery-create-api.sh"
    shift
    [ "$#" -gt 0 ] && [ "$1" = create ] || {
        jl_error "Unknown delivery operation."
        exit "$JL_EXIT_ARGUMENTS"
    }
    shift
    jl_delivery_create_response "$@"
elif [ "${1:-}" = "system-info" ] && [ "$#" -eq 2 ] && [ "$2" = "--json" ]; then
    # Extend discovery only after complete workflow contracts ship.
    python="${JL_MIXING_PYTHON:-$(command -v python3 || true)}"
    [ -n "$python" ] && [ -x "$python" ] || {
        echo "Error: Python 3 is required to produce Automation API JSON." >&2
        exit 3
    }
    base_json="$(. "$APP_ROOT/lib/api-dispatcher-command.sh")"
    printf '%s\n' "$base_json" | "$python" -c 'import json,sys; d=json.load(sys.stdin); d["capabilities"]=sorted(set(d.get("capabilities",[])+["delivery.create","intake.validate","project.create","revision.approve","revision.create"])); print(json.dumps(d,separators=(",",":"),sort_keys=True))'
else
    # Preserve the existing system-info and client.create dispatcher behavior
    # byte-for-byte while newer workflow adapters are layered separately.
    # shellcheck source=lib/api-dispatcher-command.sh
    . "$APP_ROOT/lib/api-dispatcher-command.sh"
fi
