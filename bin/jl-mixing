#!/usr/bin/env bash
# Canonical machine-facing dispatcher launcher for the JL Mixing Automation API.
set -eu

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APP_ROOT="${JL_MIXING_HOME:-$(cd "$SCRIPT_DIR/.." && pwd)}"

if [ "${1:-}" = "project" ]; then
    # shellcheck source=lib/project-create-api.sh
    . "$APP_ROOT/lib/project-create-api.sh"
    shift
    [ "$#" -gt 0 ] && [ "$1" = create ] || {
        jl_error "Unknown project operation."
        exit "$JL_EXIT_ARGUMENTS"
    }
    shift
    jl_project_create_response "$@"
else
    # Preserve the existing system-info and client.create dispatcher behavior
    # byte-for-byte while project.create is added as a separate adapter.
    # shellcheck source=lib/api-dispatcher-command.sh
    . "$APP_ROOT/lib/api-dispatcher-command.sh"
fi
