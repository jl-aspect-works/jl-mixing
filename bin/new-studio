#!/usr/bin/env bash
# Create a new JL Mixing Automation v1.1 studio workspace.
#
# The command creates a minimal workspace containing only Clients/ and the
# Studio/studio.json governing record. It refuses every existing destination
# so a previous workspace, file, or symbolic link can never be adopted or
# overwritten accidentally.
set -eu

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APP_ROOT="${JL_MIXING_HOME:-$(cd "$SCRIPT_DIR/.." && pwd)}"
# shellcheck source=lib/common.sh
. "$APP_ROOT/lib/common.sh"
# shellcheck source=lib/platform.sh
. "$APP_ROOT/lib/platform.sh"
# shellcheck source=lib/filesystem.sh
. "$APP_ROOT/lib/filesystem.sh"
# shellcheck source=lib/json.sh
. "$APP_ROOT/lib/json.sh"
# shellcheck source=lib/metadata.sh
. "$APP_ROOT/lib/metadata.sh"
# shellcheck source=lib/naming.sh
. "$APP_ROOT/lib/naming.sh"
# shellcheck source=lib/templates.sh
. "$APP_ROOT/lib/templates.sh"
# shellcheck source=lib/transaction.sh
. "$APP_ROOT/lib/transaction.sh"
# shellcheck source=lib/validation.sh
. "$APP_ROOT/lib/validation.sh"

usage() {
    cat <<'USAGE'
Usage: new-studio [options]

Options:
  --root PATH          Workspace root (default: ~/Music/Mixes)
  --name NAME          Studio name (default: Mixing Studio)
  --engineer NAME      Default mix engineer
  --sample-rate HZ     Default sample rate (default: 48000)
  --bit-depth BITS     Default bit depth (default: 24)
  --file-format FORMAT WAV or AIFF (default: WAV)
  --default-cd         Enable automatic directory changes by default
  --no-default-cd      Disable automatic directory changes by default
  --dry-run            Show the planned workspace without creating it
  -h, --help           Show this help
USAGE
}

removed_option_error() {
    case "$1" in
        --daw)
            jl_error "--daw was removed in JL Mixing 1.1."
            jl_error "DAW projects and templates are no longer managed by JL Mixing."
            ;;
        --non-interactive)
            jl_error "--non-interactive was removed in JL Mixing 1.1."
            jl_error "new-studio already uses supplied values and defaults without prompting."
            ;;
    esac
    return "$JL_EXIT_ARGUMENTS"
}

root="${JL_MIXING_ROOT:-$HOME/Music/Mixes}"
studio_name="Mixing Studio"
default_engineer=""
sample_rate=48000
bit_depth=24
file_format="WAV"
default_cd=0
default_cd_enabled_seen=0
default_cd_disabled_seen=0
default_cd_json=false
dry_run=0

while [ "$#" -gt 0 ]; do
    case "$1" in
        --root)
            [ "$#" -ge 2 ] || jl_die "--root requires a value." "$JL_EXIT_ARGUMENTS" || exit $?
            root="$2"
            shift 2
            ;;
        --name)
            [ "$#" -ge 2 ] || jl_die "--name requires a value." "$JL_EXIT_ARGUMENTS" || exit $?
            studio_name="$2"
            shift 2
            ;;
        --engineer)
            [ "$#" -ge 2 ] || jl_die "--engineer requires a value." "$JL_EXIT_ARGUMENTS" || exit $?
            default_engineer="$2"
            shift 2
            ;;
        --sample-rate)
            [ "$#" -ge 2 ] || jl_die "--sample-rate requires a value." "$JL_EXIT_ARGUMENTS" || exit $?
            sample_rate="$2"
            shift 2
            ;;
        --bit-depth)
            [ "$#" -ge 2 ] || jl_die "--bit-depth requires a value." "$JL_EXIT_ARGUMENTS" || exit $?
            bit_depth="$2"
            shift 2
            ;;
        --file-format)
            [ "$#" -ge 2 ] || jl_die "--file-format requires a value." "$JL_EXIT_ARGUMENTS" || exit $?
            file_format="$2"
            shift 2
            ;;
        --default-cd)
            default_cd=1
            default_cd_enabled_seen=1
            shift
            ;;
        --no-default-cd)
            default_cd=0
            default_cd_disabled_seen=1
            shift
            ;;
        --dry-run)
            dry_run=1
            shift
            ;;
        --daw|--non-interactive)
            removed_option_error "$1"
            exit $?
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        --*)
            jl_die "Unknown option: $1" "$JL_EXIT_ARGUMENTS"
            exit $?
            ;;
        *)
            jl_die "Unexpected positional argument: $1" "$JL_EXIT_ARGUMENTS"
            exit $?
            ;;
    esac
done

if [ "$default_cd_enabled_seen" -eq 1 ] && [ "$default_cd_disabled_seen" -eq 1 ]; then
    jl_error "--default-cd and --no-default-cd cannot be used together."
    exit "$JL_EXIT_ARGUMENTS"
fi

if [ "$default_cd" -eq 1 ]; then
    default_cd_json=true
fi

jl_assert_nonempty "$root" "studio root" || exit $?
studio_name="$(jl_trim "$studio_name")"
default_engineer="$(jl_trim "$default_engineer")"
jl_assert_nonempty "$studio_name" "studio name" || exit $?

jl_validate_sample_rate "$sample_rate" || {
    jl_error "Unsupported sample rate: $sample_rate"
    jl_error "Supported values: 44100, 48000, 88200, 96000, 176400, 192000"
    exit "$JL_EXIT_VALIDATION"
}
jl_validate_bit_depth "$bit_depth" || {
    jl_error "Unsupported bit depth: $bit_depth"
    jl_error "Supported values: 16, 24, 32"
    exit "$JL_EXIT_VALIDATION"
}
file_format="$(printf '%s' "$file_format" | tr '[:lower:]' '[:upper:]')"
jl_validate_file_format "$file_format" || {
    jl_error "Unsupported file format: $file_format"
    jl_error "Supported values: WAV, AIFF"
    exit "$JL_EXIT_VALIDATION"
}

studio_id="$(jl_slugify "$studio_name")"
if ! jl_validate_slug "$studio_id"; then
    jl_error "Studio name does not produce a valid stable studio ID: $studio_name"
    exit "$JL_EXIT_VALIDATION"
fi

root="$(jl_abspath_allow_missing "$root")" || exit $?
if [ "$root" = / ]; then
    jl_error "The filesystem root cannot be used as a studio workspace."
    exit "$JL_EXIT_UNSAFE"
fi
if [ -e "$root" ] || [ -L "$root" ]; then
    jl_error "Studio root already exists: $root"
    exit "$JL_EXIT_UNSAFE"
fi

root_parent="$(dirname "$root")"
if ! jl_fs_is_directory_no_symlink "$root_parent"; then
    jl_error "Studio root parent must be an existing directory: $root_parent"
    exit "$JL_EXIT_CONTEXT"
fi
if [ ! -w "$root_parent" ] || [ ! -x "$root_parent" ]; then
    jl_error "Studio root parent is not writable: $root_parent"
    exit "$JL_EXIT_UNSAFE"
fi
jl_fs_assert_no_symlink_components / "$root" || exit $?

jl_json_require_jq || exit $?
schema_file="$(jl_json_schema_path studio.schema.json)" || exit $?
# Resolve the validator before any filesystem mutation so dependency failures
# cannot leave a staging directory behind.
validation_python="$(jl_json_validator_python)" || {
    jl_error "Python 3 with jsonschema is required for JSON Schema validation."
    exit "$JL_EXIT_CONFIG"
}
[ -n "$validation_python" ] || exit "$JL_EXIT_CONFIG"

software_version="$(jl_software_version)" || exit $?
case "$software_version" in
    1.1.*) ;;
    *)
        jl_error "new-studio requires a JL Mixing 1.1.x application version; found $software_version."
        exit "$JL_EXIT_CONFIG"
        ;;
esac

shell_integration="not detected"
if jl_is_truthy "${JL_MIXING_SHELL_INTEGRATION:-0}"; then
    shell_integration="active"
fi

print_summary() {
    local heading engineer_display
    heading="$1"
    engineer_display="${default_engineer:-<not set>}"

    printf '%s\n\n' "$heading"
    printf 'Root:                       %s\n' "$root"
    printf 'Studio:                     %s\n' "$studio_name"
    printf 'Engineer:                   %s\n' "$engineer_display"
    printf 'Audio format:               %s Hz / %s-bit / %s\n' "$sample_rate" "$bit_depth" "$file_format"
    if [ "$default_cd" -eq 1 ]; then
        printf 'Automatic directory change: enabled\n'
        printf 'Shell integration:           %s\n' "$shell_integration"
    else
        printf 'Automatic directory change: disabled\n'
    fi
}

if [ "$dry_run" -eq 1 ]; then
    print_summary "Dry run — no changes made."
    cat <<'EOF_PLAN'

Would create:
  Clients/
  Studio/
  Studio/studio.json

After creation:
  new-client <client-id>
EOF_PLAN
    if [ "$default_cd" -eq 1 ] && [ "$shell_integration" != active ]; then
        cat <<'EOF_WARNING'

Automatic directory changes require JL Mixing shell integration.
Until it is active, creation commands will print a copy-and-paste cd command.
EOF_WARNING
    fi
    exit 0
fi

stage_root=""
cleanup_stage() {
    local status
    status=$?
    if [ -n "$stage_root" ] && { [ -e "$stage_root" ] || [ -L "$stage_root" ]; }; then
        jl_fs_remove_entry_no_follow "$stage_root" || true
    fi
    return "$status"
}
trap cleanup_stage EXIT
trap 'exit 1' HUP INT TERM

stage_root="$(jl_txn_stage_directory_near "$root")" || exit $?
chmod 755 "$stage_root"
mkdir -p "$stage_root/Clients" "$stage_root/Studio"
chmod 755 "$stage_root/Clients" "$stage_root/Studio"

created_at="$(jl_now_iso8601)"
document_id="$(jl_uuid)" || exit $?
staged_config="$stage_root/Studio/studio.json"

jl_template_render_json \
    "$APP_ROOT/templates/studio/studio.json.template" \
    "$staged_config" \
    DOCUMENT_ID "$document_id" \
    SOFTWARE_VERSION "$software_version" \
    CREATED_AT "$created_at" \
    STUDIO_ID "$studio_id" \
    STUDIO_NAME "$studio_name" \
    ROOT_PATH "$root" \
    DEFAULT_MIX_ENGINEER "$default_engineer" || exit $?

jl_json_update "$staged_config" \
    '.defaults.audio.sample_rate = $sample_rate |
     .defaults.audio.bit_depth = $bit_depth |
     .defaults.audio.file_format = $file_format |
     .cli.change_directory_after_create = $default_cd' \
    --argjson sample_rate "$sample_rate" \
    --argjson bit_depth "$bit_depth" \
    --arg file_format "$file_format" \
    --argjson default_cd "$default_cd_json" || exit $?

jl_json_validate_schema "$schema_file" "$staged_config" >/dev/null || exit $?
jl_metadata_validate_v11 "$staged_config" mixing-studio mutable || exit $?

jl_txn_commit_new_directory "$stage_root" "$root" || exit $?
stage_root=""

print_summary "Studio created successfully."
printf 'Configuration:                %s\n' "$root/Studio/studio.json"
if [ "$default_cd" -eq 1 ] && [ "$shell_integration" != active ]; then
    cat <<'EOF_WARNING'

Automatic directory changes require JL Mixing shell integration.
Until it is active, creation commands will print a copy-and-paste cd command.
EOF_WARNING
fi
cat <<'EOF_NEXT'

Next:
  new-client <client-id>
EOF_NEXT
