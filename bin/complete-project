#!/usr/bin/env bash
set -eu

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    cat <<'EOF'
Usage: complete-project [options]

This command is specified in docs/SCRIPT_REFERENCE.md but is not implemented
in Batch 1.
EOF
    exit 0
fi

echo "complete-project is not implemented in Batch 1." >&2
exit 2
