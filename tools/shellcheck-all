#!/usr/bin/env bash
set -eu

if ! command -v shellcheck >/dev/null 2>&1; then
    echo "ShellCheck is not installed; skipping."
    exit 0
fi

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$REPO_ROOT"

find bin lib tools tests -type f \
    \( -name '*.sh' -o -path 'bin/*' -o -path 'tools/*' \) \
    -print |
while IFS= read -r file; do
    shellcheck \
        --severity=warning \
        "$file"
done